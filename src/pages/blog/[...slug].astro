---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const d = post.data.date;
const fmt = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
---
<BaseLayout title={`${post.data.title} · oldyears`} description={post.data.description}>
  <article class="post">
    <header class="post-header">
      <div class="post-meta">
        <time>{fmt}</time>
        {post.data.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
      <h1>{post.data.title}</h1>
    </header>
    <div class="post-body">
      <Content />
    </div>
    <a href="/blog/" class="back">← 返回博客列表</a>
  </article>

  <style>
    .post-header { margin-bottom: 28px; }
    .post-meta { display: flex; align-items: center; gap: 10px; font-size: .82em; color: var(--text-soft); }
    .tag { background: var(--bg-soft); border: 1px solid var(--border); border-radius: 10px; padding: 1px 9px; }
    .post-header h1 { margin: 10px 0 0; }
    .back { display: inline-block; margin-top: 36px; color: var(--text-soft); font-size: .9em; }
  </style>

  <style is:global>
    .post-body { font-size: 1.02em; }
    .post-body p { margin: 1em 0; }
    .post-body blockquote {
      border-left: 4px solid var(--accent); background: var(--bg-soft);
      margin: 1.2em 0; padding: 10px 18px; border-radius: 0 6px 6px 0; color: var(--text-soft);
    }
    .post-body img { max-width: 100%; border-radius: 8px; }
    .post-body h2, .post-body h3 { margin-top: 1.6em; }
    .post-body a { color: var(--accent); }
  </style>
</BaseLayout>
