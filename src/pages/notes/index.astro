---
import BaseLayout from "../../layouts/BaseLayout.astro";
import notes from "../../../notes-manifest.json";

// 笔记元信息来自 notes-manifest.json（同步脚本与本页共用同一清单）
// html 原件由 CI 从 codeFiles 同步到 public/notes/，链接直达，保内部 MathJax/交互
---
<BaseLayout title="学习笔记 · oldyears" description="CMU 10-714 深度学习系统学习笔记，含公式推导与交互可视化">
  <h1>学习笔记</h1>
  <p class="sub">
    CMU 10-714 深度学习系统 · 跟着课程推导，配可交互的可视化。每篇标注来源与对应作业，
    只讲思路不给作业答案。
  </p>

  <div class="note-list">
    {notes.map((n) => (
      <a href={`/notes/${n.file}`} class="card note-item">
        <div class="note-course">{n.course}</div>
        <h2>{n.title}</h2>
        <p class="note-desc">{n.desc}</p>
        <div class="note-tags">
          {n.tags.map((t) => <span class="tag">{t}</span>)}
        </div>
      </a>
    ))}
  </div>

  <p class="foot-note">
    💡 笔记为独立 HTML，公式用 MathJax 渲染、交互用原生 JS，点击卡片在新页面打开。
  </p>

  <style>
    .sub { color: var(--text-soft); margin-top: -6px; max-width: 640px; }
    .note-list { display: flex; flex-direction: column; gap: 16px; margin-top: 24px; }
    .note-item { color: var(--text); display: flex; flex-direction: column; gap: 6px; }
    .note-item:hover { text-decoration: none; }
    .note-course { font-size: .8em; color: var(--accent); font-weight: 600; }
    .note-item h2 { margin: 2px 0; font-size: 1.2em; }
    .note-desc { color: var(--text-soft); font-size: .92em; margin: 0 0 4px; }
    .note-tags { display: flex; gap: 8px; flex-wrap: wrap; }
    .tag { background: var(--bg-soft); border: 1px solid var(--border); border-radius: 10px; padding: 1px 9px; font-size: .78em; color: var(--text-soft); }
    .foot-note { margin-top: 28px; color: var(--text-soft); font-size: .85em; }
  </style>
</BaseLayout>
