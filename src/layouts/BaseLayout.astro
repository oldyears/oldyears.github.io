---
export interface Props {
  title: string;
  description?: string;
}
const { title, description = "oldyears 的个人站点 · 学习笔记与随笔" } = Astro.props;
const nav = [
  { href: "/", label: "首页" },
  { href: "/blog/", label: "博客" },
  { href: "/notes/", label: "学习笔记" },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---
<!doctype html>
<html lang="zh">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📘</text></svg>" />
  <script is:inline>
    // 暗色初始化（防闪烁）：读 localStorage 或系统偏好
    (function () {
      const t = localStorage.getItem("theme");
      const dark = t === "dark" || (!t && matchMedia("(prefers-color-scheme: dark)").matches);
      if (dark) document.documentElement.classList.add("dark");
    })();
  </script>
</head>
<body>
  <header class="site-header">
    <nav class="nav">
      <a href="/" class="brand">oldyears</a>
      <div class="nav-links">
        {nav.map((n) => (
          <a href={n.href} class={isActive(n.href) ? "active" : ""}>{n.label}</a>
        ))}
        <button id="theme-toggle" aria-label="切换主题" title="切换亮/暗色">🌗</button>
      </div>
    </nav>
  </header>

  <main class="site-main">
    <slot />
  </main>

  <footer class="site-footer">
    <p>© {new Date().getFullYear()} oldyears · 用 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 构建</p>
  </footer>

  <script is:inline>
    document.getElementById("theme-toggle")?.addEventListener("click", () => {
      const dark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", dark ? "dark" : "light");
    });
  </script>

  <style is:global>
    :root {
      --accent: #4a90d9;
      --accent-2: #22a06b;
      --bg: #ffffff;
      --bg-soft: #f6f8fa;
      --card: #ffffff;
      --border: #e3e8ee;
      --text: #1f2328;
      --text-soft: #57606a;
      --shadow: 0 1px 3px rgba(27,31,36,.08), 0 4px 12px rgba(27,31,36,.04);
    }
    html.dark {
      --bg: #0d1117;
      --bg-soft: #161b22;
      --card: #161b22;
      --border: #30363d;
      --text: #e6edf3;
      --text-soft: #9198a1;
      --shadow: 0 1px 3px rgba(0,0,0,.4);
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: -apple-system, "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
      transition: background .3s, color .3s;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }

    .site-header {
      position: sticky; top: 0; z-index: 10;
      background: color-mix(in srgb, var(--bg) 85%, transparent);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border);
    }
    .nav {
      max-width: 860px; margin: 0 auto; padding: 12px 24px;
      display: flex; align-items: center; justify-content: space-between;
    }
    .brand { font-weight: 700; font-size: 1.15em; color: var(--text); }
    .brand:hover { text-decoration: none; color: var(--accent); }
    .nav-links { display: flex; align-items: center; gap: 20px; }
    .nav-links a { color: var(--text-soft); font-size: .95em; }
    .nav-links a.active { color: var(--accent); font-weight: 600; }
    .nav-links a:hover { color: var(--accent); text-decoration: none; }
    #theme-toggle {
      background: none; border: none; cursor: pointer; font-size: 1.1em;
      padding: 2px 6px; border-radius: 6px;
    }
    #theme-toggle:hover { background: var(--bg-soft); }

    .site-main { max-width: 860px; margin: 0 auto; padding: 40px 24px 60px; min-height: 70vh; }

    .site-footer {
      border-top: 1px solid var(--border);
      text-align: center; color: var(--text-soft); font-size: .85em;
      padding: 24px; margin-top: 40px;
    }

    /* 通用卡片 */
    .card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 12px; padding: 20px 22px; box-shadow: var(--shadow);
      transition: transform .18s, box-shadow .18s;
    }
    .card:hover { transform: translateY(-2px); box-shadow: 0 4px 16px rgba(27,31,36,.12); }
    h1 { font-size: 1.8em; line-height: 1.3; }
    h2 { font-size: 1.3em; }
  </style>
</body>
</html>
